# Environment Configuration for Decentro Trace

# Backend Config
ENVIRONMENT=development
PORT=8000
DATABASE_URL=sqlite:///./decentro_trace.db

# AI Provider Configuration
# Options: mock, openai, gemini, anthropic
AI_PROVIDER=mock

# Optional API Keys (if using real LLM providers)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Frontend Config
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
